# Australian Bee Journal reader
# Article pages are real directories (article/<slug>/index.html), so Apache
# serves them natively -- no rewrite rules needed. This file is only hygiene.

DirectoryIndex index.html
Options -Indexes

# Apache appends the trailing slash on directory URLs itself, and does it
# relative to the install path. Doing it by hand with a rewrite would break
# the moment this sits in a subfolder such as /reader/.
DirectorySlash On

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css   "access plus 1 week"
  ExpiresByType text/html  "access plus 10 minutes"
</IfModule>

# NOTE: if you switch on Directory Privacy in cPanel, cPanel writes its
# AuthType/AuthUserFile lines into THIS file. Leave them in place.
